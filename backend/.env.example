OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Spec Builder's own model choice. pydantic-ai reads the *_API_KEY matching
# whichever provider this names -- ANTHROPIC_API_KEY below for the Anthropic
# default, or OPENAI_API_KEY above if you point this at openai:... instead.
#   AIPM_MODEL=anthropic:claude-sonnet-5
#   AIPM_MODEL=openai:gpt-5
AIPM_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# Optional: only needed to push Epics/Stories to a real Jira project from the
# Epics section of a spec (Spec Builder). Leave unset to skip -- the push
# button just won't show up. Generate an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@your-company.com
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=PROJ
