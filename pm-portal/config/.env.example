# Copy this file to config/.env and fill in your key(s).

# Which model the Extraction/Clarify/Generation agents (backend/agents.py) use,
# in pydantic-ai's "<provider>:<model>" format. Defaults to Anthropic if unset.
#   AIPM_MODEL=anthropic:claude-sonnet-5
#   AIPM_MODEL=openai:gpt-5
AIPM_MODEL=anthropic:claude-sonnet-5

# Set the key matching whichever provider AIPM_MODEL points at -- only one is
# required, based on your choice above.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# Optional: only needed to push Epics/Stories to a real Jira project from the
# Epics section of a spec. Leave unset to skip -- the push button just won't
# show up. Generate an API token at
# https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@your-company.com
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=PROJ
